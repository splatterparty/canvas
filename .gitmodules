[submodule "lib/openzeppelin-contracts"]
	path = lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "lib/solidstate-solidity"]
	path = lib/solidstate-solidity
	url = https://github.com/solidstate-network/solidstate-solidity.git	
[submodule "lib/diamond-2-hardhat"]
	path = lib/diamond-2-hardhat
	url = https://github.com/gemstation/diamond-2-hardhat
	branch = gemforge-2
[submodule "lib/forge-std"]
	path = lib/forge-std
	url = https://github.com/foundry-rs/forge-std.git
